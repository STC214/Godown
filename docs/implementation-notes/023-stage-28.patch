+func completedFileMatches(output, completionPath string, size int64) bool {
+	stat, err := os.Stat(output)
+	if err != nil || stat.IsDir() || (size >= 0 && stat.Size() != size) {
+		return false
+	}
+	want, err := os.ReadFile(completionPath)
+	if err != nil {
+		return false
+	}
+	got, err := fileSHA256(output)
+	return err == nil && strings.TrimSpace(string(want)) == got
+}
+
+func writeCompletionMarker(output, completionPath string) error {
+	digest, err := fileSHA256(output)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(completionPath), 0o755); err != nil {
+		return err
+	}
+	temporary := completionPath + ".tmp"
+	if err := os.WriteFile(temporary, []byte(digest+"\n"), 0o600); err != nil {
+		return err
+	}
+	defer os.Remove(temporary)
+	if err := os.Remove(completionPath); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	return os.Rename(temporary, completionPath)
+}
+
+func fileSHA256(name string) (string, error) {
+	file, err := os.Open(name)
+	if err != nil {
+		return "", err
+	}
+	defer file.Close()
+	hash := sha256.New()
+	if _, err := io.Copy(hash, file); err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%x", hash.Sum(nil)), nil
+}

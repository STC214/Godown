+			report(progress.Received, progress.Speed, "正在下载 FTP 文件")
+		})
+		if err == nil {
+			break
+		}
+		if ctx.Err() != nil {
+			return received, ctx.Err()
+		}
+		if received > start {
+			failures = 0
+		}
+		failures++
+		if failures > maxRetries {
+			return received, err
+		}
+		select {
+		case <-ctx.Done():

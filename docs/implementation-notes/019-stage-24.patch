+// Closing the underlying socket interrupts both data reads and final control
+// replies, without waiting for Response.Close's serialized protocol cleanup.
+type contextConn struct {
+	net.Conn
+	stop func() bool
+}
+
+func (c *contextConn) Close() error {
+	c.stop()
+	return c.Conn.Close()
+}

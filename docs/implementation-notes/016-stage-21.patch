+		if row < 0 || row >= len(m.rows) {
+			return fmt.Errorf("BitTorrent 文件行 %d 超出范围", row)
+		}
+		m.rows[row].checked = true
+		m.rows[row].file.Priority = priority
+		m.PublishRowChanged(row)
+	}
+	m.notifyChanged()
+	return nil
+}

+	stateSourceType          = "sourceType"
+	stateTrackers            = "trackers"
+	stateFiles               = "files"
+	stateMetadataTimeout     = "metadataTimeoutSec"
+	stateListenPort          = "listenPort"
+	stateConnectionsLimit    = "connectionsLimit"

+func TestTaskSnapshotAllowsOpeningAndPausingSeedingContent(t *testing.T) {
+	registry := core.NewRegistry()
+	scheduler := core.NewScheduler(registry, nil, 1)
+	defer scheduler.StopAll()
+	dir := t.TempDir()
+	task := core.NewTask("bt", "bundle", "fixture://torrent", dir, 1, core.NewStage("bt", "fixture://torrent", 1, 1, 0, false, nil, ""))
+	task.Status = core.StatusSeeding
+	task.Stage.Status = core.StatusSeeding
+	if err := os.Mkdir(filepath.Join(dir, task.Title), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	scheduler.Add(task)
+	payload := taskSnapshotPayload(scheduler)
+	tasks := payload["tasks"].([]map[string]any)
+	if len(tasks) != 1 || tasks[0]["canOpenFile"] != true || tasks[0]["canPause"] != true {
+		t.Fatalf("seeding task capabilities are wrong: %#v", tasks)
+	}
+}
